# Environment variables (never commit these)
.env
*.env

# Python
venv/
__pycache__/
*.pyc

# Chroma DB (local vector store)
backend/chroma_db/

# Uploaded files
backend/uploads/

# Node
frontend/node_modules/
frontend/dist/

# Python virtualenv and local models
backend/.venv/
.venv/
.pytest_cache/

# Downloaded benchmark data (re-downloaded by eval/beir_eval.py)
backend/eval/data/

# Local-only files: never publish
/docs.html
/interview_prep.html
/*.pdf
*.local
.DS_Store

# Synthetic eval PDFs are generated by eval/fixtures/make_fixtures.py, never committed
backend/eval/fixtures/*.pdf

# Evaluation corpus, questions and per-question answers stay local (not published)
backend/eval/fixtures/
backend/eval/dataset.json
backend/eval/results/latest.json
