# Required
GROQ_API_KEY=

# Optional: extra fallbacks on OpenRouter (only providers that don't store or train on data are used)
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODELS=

# Optional tuning
ALLOWED_ORIGINS=*              # e.g. https://rag-document-chatbot.vercel.app
SESSION_TTL_SECONDS=600
RERANK_ENABLED=1               # set 0 on very small instances to save ~280 MB RAM
ONNX_THREADS=2
MODEL_CACHE=                   # e.g. /app/.models
DAILY_TOKEN_BUDGET=0           # 0 = unlimited; a hard daily cap protects paid credits
TTS_VOICE=autumn
